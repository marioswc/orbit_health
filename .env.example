ORBIT_DB_PATH=./data/orbit_health.db
ORBIT_FACTOR_ACELERACION=30
# Perfiles de latencia en backend/app/datos/enlace.json; estas variables los sobrescriben (opcional).
# ORBIT_LATENCIA_MARTE_S=1200
# ORBIT_LATENCIA_LUNA_S=1.3
ORBIT_JITTER_PCT=0
# ORBIT_JITTER_SEMILLA=42
ORBIT_VENTANA_NEWS2_MIN=60
ORBIT_DIAS_LINEA_BASE=14
ORBIT_MODO_PARAMETRO_EXTREMO=conservador
ORBIT_SEED_DEMO=1
ORBIT_DEMO_API=1

# Seguridad a bordo (ver docs/SEGURIDAD_A_BORDO.md). Obligatoria si se expone en la red de la cabina.
ORBIT_AUTH=0
# ORBIT_HOST=127.0.0.1
# ORBIT_SESION_HORAS=12
# ORBIT_MAX_INTENTOS=5
# ORBIT_BLOQUEO_MIN=5

# Autorrecuperación (ver README): respaldos automáticos y restauración al arrancar.
# ORBIT_RESPALDO_CADA_MIN=30
# ORBIT_RESPALDOS_CONSERVAR=24
# ORBIT_DIR_RESPALDOS=./data/respaldos

# Otras variables que lee el código (todas opcionales):
# ORBIT_PUERTO=3000                 # puerto de run.sh
# ORBIT_UMBRALES=./umbrales.json    # archivo de umbrales distinto (p. ej. el aprobado por un clínico)
# ORBIT_FRONTEND_DIST=./frontend/dist
# ORBIT_PBKDF2_ITER=200000          # iteraciones del hash de PIN (bajarlo solo en pruebas)
# ORBIT_PERMITIR_RED=0              # 1 = permitir ORBIT_HOST fuera de localhost SIN autenticación (no recomendado)

# Flujo continuo de sensores: se agrupa en ventanas, salvo los valores extremos, que pasan de inmediato.
# ORBIT_FLUJO_VENTANA_S=60
# ORBIT_PRECALENTAR=1
# ORBIT_IA_MODELO_GGUF=      # ruta a un modelo .gguf: IA incrustada, sin Ollama (ver docs/IA_LOCAL.md)
# ORBIT_IA_HILOS=0                # 0 = automático: núcleos físicos
# ORBIT_IA_EMBEBIDA_TIMEOUT_S=60  # tiempo máximo generando una respuesta con el modelo incrustado
# ORBIT_IA_DESCARGA_MIN=15        # minutos sin uso antes de liberar la memoria del modelo incrustado (0 = nunca)
# ORBIT_PRECALENTAR_VOZ=0         # 1 = cargar también la voz al arrancar (más rápida la primera vez, pero ocupa memoria)
# ORBIT_ENV_FILE=          # solo el ejecutable: ruta del .env del usuario (el lanzador la pone en su carpeta de datos)
# ORBIT_IA_MAX_SIMULTANEAS=2
# ORBIT_IA_PETICIONES_POR_MIN=30
# ORBIT_IA_LOCAL_KEEP_ALIVE=30m
# ORBIT_COMPACTAR_RUTINA_DESDE=20
# ORBIT_FLUJO_ENFRIAMIENTO_S=30

# IA local opcional (compatible con /api/generate de Ollama; nunca usa un host externo).
# Si no se configura, el backend usa una explicación determinista sin modelo.
# ORBIT_IA_LOCAL_URL=http://127.0.0.1:11434/api/generate
# ORBIT_IA_LOCAL_MODELO=qwen2.5:3b
# ORBIT_IA_LOCAL_TIMEOUT_S=4

# En modo automático se prueba Ollama, luego DeepSeek y finalmente las reglas locales.
# OJO: usar DeepSeek envía el texto fuera del equipo hacia api.deepseek.com.
# ORBIT_IA_PROVEEDOR=automatico
# ORBIT_IA_PROVEEDOR=deepseek
# ORBIT_DEEPSEEK_API_KEY=
# ORBIT_DEEPSEEK_MODELO=deepseek-flash
# ORBIT_DEEPSEEK_URL=https://api.deepseek.com/chat/completions
# ORBIT_DEEPSEEK_TIMEOUT_S=20

# Voz local opcional: instalar backend/requirements-voice.txt y descargar modelos localmente.
# Para activarla, copia estas variables a .env y apunta a una carpeta Whisper existente.
# El endpoint recibe audio crudo (WAV/WebM/OGG/MP3/M4A), no guarda audio en SQLite.
# ORBIT_VOZ_ACTIVA=1
# ORBIT_VOZ_STT_MODELO=./models/whisper-small
# ORBIT_VOZ_STT_LOCAL_ONLY=1
# ORBIT_VOZ_PIPER_BIN=piper
# ORBIT_VOZ_PIPER_MODELO=./models/es_MX-claude-high.onnx
# ORBIT_VOZ_PIPER_MODELO_EN=./models/en_US-lessac-medium.onnx
# ORBIT_VOZ_MAX_AUDIO_BYTES=10000000
# ORBIT_VOZ_MAX_RESPUESTA_CARACTERES=600

# --- Solo para scripts y contenedores (no los lee la aplicación, pero son nombres válidos) ---
# ORBIT_CONTENEDOR_HOST=0.0.0.0   # Docker: dirección en la que escucha DENTRO del contenedor (el acceso externo lo limita docker-compose a 127.0.0.1)
# ORBIT_TOKEN=                    # scripts/puente_ble.py: token de sesión cuando la autenticación está activa
# ORBIT_SIN_IA=0                  # scripts/crear_ejecutable.sh: 1 = construir el ejecutable sin el motor de IA incrustado
# ORBIT_OLLAMA_DIR=               # scripts/instalar_ia_local.sh: carpeta donde instalar Ollama (por defecto ~/.local/ollama)
# ORBIT_AUDITORIA_SIN_RED=0       # scripts/auditoria_seguridad.py: 1 = omitir la revisión de dependencias (necesita internet)
